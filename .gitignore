# Installed dependencies. The root node_modules belongs to the AGENT, not to
# app/: tools/scripts/_github.mjs imports @composio/core, so a GAP agent with
# runtime:node tools has real npm dependencies. app/web keeps its own.
node_modules/

# Vite output, built at deploy time and served by app/server.
dist/

# Runtime state: sessions, audit logs, learned-skill metadata. Not source.
.gitagent/

# Credentials. The runtime auto-loads this file from the agent dir.
.env

# Scratch space the runtime's `write` tool outputs into. Badger is read-only
# and `write` is in neither allowlist, so nothing can ever put a file here —
# but the scaffold creates it and a CLI run may recreate it, so it stays
# ignored rather than tracked.
workspace/

.DS_Store

# Local dev tooling, not part of the deliverable: the Composio skill installed
# for Claude Code (npx skills add ComposioHQ/composio). It helps build the
# integration; it is not one of Badger's own skills and must not be confused
# with skills/. Reinstall with the command above.
.agents/
.claude/
skills-lock.json

# Session handoff and submission planning. Development notes, not the
# deliverable. See README.md for what Badger is.
CLAUDE.md
SUBMISSION-PLAN.md
