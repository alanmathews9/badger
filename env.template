# Badger credentials. Copy to .env (gitignored) — never commit the filled copy.
# The runtime loads <agent-dir>/.env automatically, and it wins over
# ~/.gitagent/.env and over stale shell exports.

# --- model (required) ------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
# Also powers `gitagent --voice gemini` for the web UI on :3333.
GEMINI_API_KEY=

# --- sources (phase 2, leave blank for now) --------------------------------
# GitHub PAT — read-only scopes only: repo:status, public_repo, read:org
GITHUB_TOKEN=

# Gmail + Drive OAuth client JSON path. Exact var name depends on which MCP
# server we settle on next session.
GOOGLE_OAUTH_CREDENTIALS=

# --- web UI (set before this goes on a VPS) --------------------------------
# The UI is unauthenticated by default and exposes a file browser + shell.
GITAGENT_USERNAME=
GITAGENT_PASSWORD=
